<?xml version="1.0" encoding="utf-8"?>
<!--suppress LongLine -->
<resources>
    <!-- Menu option / screen title: remote desktop. -->
    <string name="ui_remote_desktop">Remote Desktop</string>
    <!-- Screen title. -->
    <string name="rd_screen_title">Remote Desktop</string>
    <!-- Information text on the remote desktop screen. -->
     <string name="rd_hint">Streams the screen as MJPEG over HTTP; enable Accessibility for remote control. This service has no authentication or TLS: anyone who can reach the port can view the screen and may control the device. Use only on a trusted private network; never expose it through public frpc.</string>

    <!-- Name of the background service. -->
    <string name="rd_service_name">Phone Security Assistant Remote Desktop</string>
    <!-- Service description needed for Android OS. -->
    <string name="rd_service_description">Captures the screen and streams it over HTTP.</string>
    <!-- Notification text while starting. -->
    <string name="rd_notification_starting">Starting remote desktop…</string>
    <!-- Notification text while running.
         Param 1: port number. -->
    <string name="rd_notification_running_fmt">Remote desktop running, port %1$s</string>

    <!-- Task state: idle. -->
    <string name="rd_status_idle">Idle</string>
    <!-- Task state: running. -->
    <string name="rd_status_running">Running</string>
    <!-- Button: start. -->
    <string name="rd_btn_start">Start sharing</string>
    <!-- Button: stop. -->
    <string name="rd_btn_stop">Stop sharing</string>
    <!-- Port input hint. -->
    <string name="rd_port">HTTP port (default 8888)</string>
    <!-- Connection URL.
         Param 1: port number. -->
     <string name="rd_url_fmt">Use only on a trusted LAN or private Tailscale network: http://&lt;device-ip&gt;:%1$s; do not expose through a public relay</string>

    <!-- Accessibility section header. -->
    <string name="rd_accessibility_section">Remote control setup</string>
    <!-- Accessibility enabled. -->
    <string name="rd_accessibility_enabled">Accessibility service enabled, remote control ready</string>
    <!-- Accessibility disabled. -->
    <string name="rd_accessibility_disabled">Accessibility service not enabled, remote control unavailable. Please enable "Phone Security Assistant Remote Desktop" in system Accessibility settings.</string>
    <!-- Button: open accessibility settings. -->
    <string name="rd_btn_accessibility">Open accessibility settings</string>
    <!-- Accessibility service label (shown in system settings). -->
    <string name="rd_accessibility_name">Phone Security Assistant Remote Control</string>
    <!-- Accessibility service description (shown in system settings). -->
    <string name="rd_accessibility_description">Allows remote users to tap and swipe to control this device via Phone Security Assistant Remote Desktop.</string>

    <!-- Error: MediaProjection not available. -->
    <string name="rd_error_no_projection">Cannot get screen capture permission</string>
</resources>
